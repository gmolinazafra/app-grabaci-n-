<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F1F5F9">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎙️  GrabaTexto" android:textSize="28sp" android:textStyle="bold" android:textColor="#0F172A"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Grabación segura incluso con la pantalla apagada" android:textSize="15sp" android:textColor="#64748B"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:gravity="center" android:text="Listo para grabar" android:textSize="17sp" android:textColor="#64748B"/>
<TextView android:id="@+id/timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="00:00:00" android:textSize="52sp" android:textStyle="bold" android:textColor="#0F172A"/>
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="30dp" android:text="●  GRABAR" android:textSize="18sp"/>
<Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:enabled="false" android:text="■  FINALIZAR" android:textSize="18sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:padding="16dp" android:background="#FFFFFF" android:text="Durante la grabación puedes minimizar GrabaTexto o bloquear la pantalla. La notificación de Android confirma que la grabación continúa activa.&#10;&#10;Los audios se guardan en el almacenamiento privado de la app." android:textColor="#475569" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Grabaciones recientes" android:textSize="19sp" android:textStyle="bold" android:textColor="#0F172A"/>
<TextView android:id="@+id/recordings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Todavía no hay grabaciones." android:textSize="14sp" android:textColor="#64748B"/>
</LinearLayout></ScrollView>
